# CMDB 本地开发环境变量样例，复制为 .env 后按需修改

HTTP_ADDR=:8080
PG_DSN=postgres://cmdb:cmdb_dev_password@localhost:5432/cmdb?sslmode=disable
REDIS_ADDR=localhost:6379
NATS_URL=nats://localhost:4222

# 填入 n9e 只读 token 后 n9e 消费器方可工作
N9E_API_URL=
N9E_API_TOKEN=

# 认证与 RBAC
# JWT 会话签名密钥：生产环境必须显式配置（缺省使用开发默认值并打印警告）
JWT_SECRET=
# 会话有效期（小时），默认 24
TOKEN_TTL_HOURS=24
# 内置账号初始密码，仅在首次启动种子账号时生效
ADMIN_INITIAL_PASSWORD=admin123
COLLECTOR_INITIAL_PASSWORD=collector123
